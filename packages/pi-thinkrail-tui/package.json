{
  "name": "pi-thinkrail-tui",
  "version": "0.1.0",
  "description": "ThinkRail's TUI-portable pieces for vanilla pi: visualize, structured questions, and the workflow skill family. No web or desktop host.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "thinkrail",
    "tui",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "fourhu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fourhu/pi-config.git",
    "directory": "packages/pi-thinkrail-tui"
  },
  "type": "module",
  "files": [
    "index.ts",
    "workflow.ts",
    "skills/",
    "prompts/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./index.ts": "./index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@thinkrail/pi-ask-user-question": "0.2.0",
    "@thinkrail/pi-visualize": "0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  }
}
